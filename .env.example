# Copy to .env and fill in
OPENAI_API_KEY=your_openai_api_key


# OpenAI model used by the agent
AGENT_MODEL=gpt-4.1-mini

# Vector store persistence
CHROMA_DIR=./storage/chroma
COLLECTION_NAME=intellidesk_kb

# Business database (SQLite for the demo; swap for Postgres in prod)
BUSINESS_DB=./storage/business.db

# MCP server (stdio transport is used by default; these are for SSE mode)
MCP_HOST=127.0.0.1
MCP_PORT=8901
